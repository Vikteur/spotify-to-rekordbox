# Shell scripts and server config are scp'd to Linux boxes — CRLF breaks
# them there ("set: pipefail: invalid option name"), so pin them to LF even
# when checked out on Windows.
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Caddyfile text eol=lf
*.conf  text eol=lf
Dockerfile text eol=lf
