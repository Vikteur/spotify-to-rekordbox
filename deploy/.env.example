# Copy to $APP_DIR/.env on the server. CI overwrites APP_IMAGE on every deploy;
# everything else is yours to set once and leave alone. Never commit the real one.

# Set by CI. Leave the bootstrap placeholder until the first deploy lands.
APP_IMAGE=ghcr.io/vikteur/spotify-to-rekordbox:latest

# Loopback port the container publishes on. Change it if 8000 is taken.
APP_PORT=8000

TZ=Europe/Brussels

# --- optional built-in TLS proxy ------------------------------------------
# Uncomment to have the bundled Caddy service terminate HTTPS for you.
# Leave them commented if you already run nginx/Traefik on this box.
#COMPOSE_PROFILES=proxy
#APP_DOMAIN=rekordmatch.example.com
#APP_TLS_EMAIL=you@example.com

# --- auth (TEMPORARILY OFF) ------------------------------------------------
# Both gates are switched off on purpose right now:
#
#   proxy password   commented out in Caddyfile and nginx/rekord.conf
#   magic-link checks bypassed in server/couples_api.py
#
# So the whole site is open: GET /api/couples/{id} returns every couple's
# magic-link tokens to anyone who asks, and /api/scan reads folders on the box.
# To turn auth back on, un-comment the basic_auth blocks and set:
#AUTH_DISABLED=0

# --- DJ password (REQUIRED once the gate is back on) -----------------------
# Unused while the basic_auth block above is commented out. Set it now anyway,
# so re-enabling the gate is a one-line change.
#
# Generate the hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
#
# Then paste it below with EVERY $ DOUBLED. Compose interpolates this file, so a
# single $ gets eaten and the login silently fails:
#   hash   $2a$14$Fa4TaL...
#   here   $$2a$$14$$Fa4TaL...
DJ_USER=dj
DJ_PASSWORD_HASH=

# --- app secrets ----------------------------------------------------------
# Only needed for Spotify search in the couples intake (server/spotify/search.py).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
