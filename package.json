{
  "name": "spotify-to-rekordbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"vite\"",
    "dev:api": "python -m server.run --reload",
    "build": "tsc --noEmit && vite build",
    "start": "python -m server.run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/e2e-matches.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
